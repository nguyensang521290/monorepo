# Multi-stage Dockerfile for Identity Service Development
FROM eclipse-temurin:17-jdk AS build
WORKDIR /app

# Copy gradle wrapper and configuration files from the project root
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .
COPY build-logic build-logic

# Copy shared library (dependency) and identity-service source
COPY shared-lib shared-lib
COPY identity-service identity-service

# Build the identity-service
RUN ./gradlew :identity-service:bootJar -x test

# Final stage for running the application
FROM eclipse-temurin:17-jre
WORKDIR /app

# Copy the built jar from the build stage
COPY --from=build /app/identity-service/build/libs/*.jar app.jar

# Expose the port
EXPOSE 8085

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
