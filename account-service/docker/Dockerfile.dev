# Multi-stage Dockerfile for Account Service Development
FROM eclipse-temurin:17-jdk AS build
WORKDIR /app

# Copy gradle wrapper and configuration files from the project root
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .
COPY build-logic build-logic

# Copy shared library (dependency) and account-service source
COPY shared-lib shared-lib
COPY account-service account-service

# Build the account-service
RUN ./gradlew :account-service:bootJar -x test

# Final stage for running the application
FROM eclipse-temurin:17-jre
WORKDIR /app

# Copy the built jar from the build stage
COPY --from=build /app/account-service/build/libs/*.jar app.jar

# Expose the port
EXPOSE 8084

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
